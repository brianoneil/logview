# Required for production: sign-in + JWT session cookie for the viewer /usage /api/stream.
# /api/ingest stays public (no token). Generate a long random string for LOGVIEW_AUTH_SECRET.
LOGVIEW_AUTH_SECRET=replace-with-a-long-random-secret-min-16-chars

# JSON array of valid passphrases (any one unlocks the UI; Bearer on /api/stream optional for non-browser clients).
LOGVIEW_AUTH_PASSPHRASES=["first-passphrase","another-valid-passphrase"]

# Optional (development only): skip all auth when NODE_ENV=development
# LOGVIEW_AUTH_DISABLE=true
